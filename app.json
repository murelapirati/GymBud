{
  "expo": {
    "name": "GymBud",
    "slug": "gymbud",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.murelapirati.gymbud",
      "infoPlist": {
        "NSMotionUsageDescription": "This app uses your motion data to track your daily steps and activity.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5383B8"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "package": "com.murelapirati.gymbud"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "07896dbd-b2bc-476f-b10d-6046a4a080c7"
      }
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#5383B8"
        }
      ],
      "expo-audio"
    ]
  }
}
