{
  "expo": {
    "name": "gymapp",
    "slug": "gymapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5383B8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.gymapp",
      "infoPlist": {
        "NSMotionUsageDescription": "This app uses your motion data to track your daily steps and activity.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5383B8"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "android.permission.ACTIVITY_RECOGNITION",
        "ACTIVITY_RECOGNITION",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "package": "com.anonymous.gymapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "07896dbd-b2bc-476f-b10d-6046a4a080c7"
      }
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker"
    ]
  }
}
